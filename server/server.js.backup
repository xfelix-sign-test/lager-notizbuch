/* ============================================================
   EINSTELLUNGEN
============================================================ */

app.get("/api/settings", requireLogin, async (req, res) => {
    try {
        let settings = await db.get(
            `
            SELECT
                user_id,
                display_name,
                theme,
                compact_mode
            FROM user_settings
            WHERE user_id = ?
            `,
            req.session.userId
        );

        if (!settings) {
            await db.run(
                `
                INSERT INTO user_settings
                (user_id, display_name, theme, compact_mode)
                VALUES (?, ?, 'dark', 0)
                `,
                req.session.userId,
                req.session.username
            );

            settings = await db.get(
                `
                SELECT
                    user_id,
                    display_name,
                    theme,
                    compact_mode
                FROM user_settings
                WHERE user_id = ?
                `,
                req.session.userId
            );
        }

        res.json(settings);

    } catch (error) {
        console.error("EINSTELLUNGEN LADEN FEHLER:", error);

        res.status(500).json({
            error: "Einstellungen konnten nicht geladen werden."
        });
    }
});

/* Einstellungen speichern */

app.put("/api/settings", requireLogin, async (req, res) => {
    try {
        const {
            display_name = "",
            theme = "dark",
            compact_mode = 0
        } = req.body;

        const validThemes = [
            "dark",
            "red",
            "blue"
        ];

        const selectedTheme =
            validThemes.includes(theme)
                ? theme
                : "dark";

        await db.run(
            `
            INSERT INTO user_settings
            (user_id, display_name, theme, compact_mode)
            VALUES (?, ?, ?, ?)
            ON CONFLICT(user_id)
            DO UPDATE SET
                display_name = excluded.display_name,
                theme = excluded.theme,
                compact_mode = excluded.compact_mode
            `,
            req.session.userId,
            String(display_name).trim(),
            selectedTheme,
            compact_mode ? 1 : 0
        );

        const settings = await db.get(
            `
            SELECT
                user_id,
                display_name,
                theme,
                compact_mode
            FROM user_settings
            WHERE user_id = ?
            `,
            req.session.userId
        );

        res.json(settings);

    } catch (error) {
        console.error("EINSTELLUNGEN SPEICHERN FEHLER:", error);

        res.status(500).json({
            error: "Einstellungen konnten nicht gespeichert werden."
        });
    }
});

/* Passwort ändern */

app.put("/api/settings/password", requireLogin, async (req, res) => {
    try {
        const {
            currentPassword,
            newPassword
        } = req.body;

        if (!currentPassword || !newPassword) {
            return res.status(400).json({
                error: "Altes und neues Passwort sind erforderlich."
            });
        }

        if (newPassword.length < 6) {
            return res.status(400).json({
                error: "Das neue Passwort muss mindestens 6 Zeichen haben."
            });
        }

        const user = await db.get(
            `
            SELECT *
            FROM users
            WHERE id = ?
            `,
            req.session.userId
        );

        if (!user) {
            return res.status(401).json({
                error: "Benutzer nicht gefunden."
            });
        }

        const correct = await bcrypt.compare(
            currentPassword,
            user.password_hash
        );

        if (!correct) {
            return res.status(400).json({
                error: "Das aktuelle Passwort ist falsch."
            });
        }

        const passwordHash = await bcrypt.hash(
            newPassword,
            12
        );

        await db.run(
            `
            UPDATE users
            SET password_hash = ?
            WHERE id = ?
            `,
            passwordHash,
            req.session.userId
        );

        res.json({
            success: true
        });

    } catch (error) {
        console.error("PASSWORT ÄNDERN FEHLER:", error);

        res.status(500).json({
            error: "Passwort konnte nicht geändert werden."
        });
    }
});

/* =========================
   APP
========================= */

app.get("/app", (req, res) => {
    if (!req.session.userId) {
        return res.redirect("/");
    }

    res.sendFile(
        path.join(PUBLIC_DIR, "app.html")
    );
});

/* =========================
   SERVER
========================= */

app.listen(PORT, "0.0.0.0", () => {
    console.log("");
    console.log("======================================");
    console.log("       LAGER-NOTIZBUCH");
    console.log("======================================");
    console.log(`Server läuft auf Port ${PORT}`);
    console.log("");
});
