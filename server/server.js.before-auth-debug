function normalizeSettings(body) {
    const validThemes = ["dark", "black"];
    const validFontSizes = ["small", "medium", "large"];
    const validCategories = [
        "programme",
        "ablaeufe",
        "merke",
        "extras"
    ];
    const validNoteSorts = [
        "newest",
        "oldest",
        "az"
    ];
    const validContactSorts = [
        "name",
        "branch"
    ];
    const validPageSizes = [10, 20, 50, 100];

    return {
        display_name: String(body.display_name ?? "").trim().slice(0, 100),

        department:
            String(body.department ?? "")
                .trim()
                .slice(0, 100),

        theme:
            validThemes.includes(body.theme)
                ? body.theme
                : "dark",

        font_size:
            validFontSizes.includes(body.font_size)
                ? body.font_size
                : "medium",

        compact_mode:
            body.compact_mode ? 1 : 0,

        default_category:
            validCategories.includes(body.default_category)
                ? body.default_category
                : "programme",

        note_sort:
            validNoteSorts.includes(body.note_sort)
                ? body.note_sort
                : "newest",

        notes_per_page:
            validPageSizes.includes(Number(body.notes_per_page))
                ? Number(body.notes_per_page)
                : 20,

        contact_sort:
            validContactSorts.includes(body.contact_sort)
                ? body.contact_sort
                : "name",

        show_branch:
            body.show_branch ? 1 : 0,

        notifications:
            body.notifications ? 1 : 0,

        save_confirmation:
            body.save_confirmation ? 1 : 0,

        auto_logout:
            body.auto_logout ? 1 : 0
    };
}


async function getSettings(userId) {
    return await db.get(
        `
        SELECT
            user_id,
            display_name,
            theme,
            compact_mode,
            department,
            font_size,
            default_category,
            note_sort,
            notes_per_page,
            contact_sort,
            show_branch,
            notifications,
            save_confirmation,
            auto_logout
        FROM user_settings
        WHERE user_id = ?
        `,
        userId
    );
}


app.get("/api/settings", requireLogin, async (req, res) => {
    try {
