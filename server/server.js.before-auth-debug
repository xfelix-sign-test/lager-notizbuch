            req.session.userId,
            settings.display_name,
            settings.theme,
            settings.compact_mode,
            settings.department,
            settings.font_size,
            settings.default_category,
            settings.note_sort,
            settings.notes_per_page,
            settings.contact_sort,
            settings.show_branch,
