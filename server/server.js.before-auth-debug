app.post("/api/notes", requireLogin, async (req, res) => {
    try {
        const {
            title,
            content,
            category
        } = req.body;

        if (!title || !title.trim()) {
            return res.status(400).json({
                error: "Titel fehlt."
            });
        }

        const validCategories = [
            "programme",
            "ablaeufe",
            "merke",
            "extras"
        ];

        const selectedCategory =
            validCategories.includes(category)
                ? category
                : "programme";

        const result = await db.run(
            `
            INSERT INTO notes
            (title, content, category)
            VALUES (?, ?, ?)
            `,
            title.trim(),
            content || "",
            selectedCategory
        );

        const note = await db.get(
            `
            SELECT *
            FROM notes
            WHERE id = ?
            `,
            result.lastID
        );

        res.status(201).json(note);

    } catch (error) {
        console.error("NOTIZ ERSTELLEN FEHLER:", error);

        res.status(500).json({
            error: "Notiz konnte nicht erstellt werden."
        });
    }
});


