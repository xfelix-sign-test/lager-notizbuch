app.post("/api/contacts", requireLogin, async (req, res) => {
    try {
        const {
            name,
            branch = "",
            extension = "",
            number = "",
            mobile = ""
        } = req.body;

        const cleanName = String(name || "").trim();
        const cleanBranch = String(branch || "").trim();
        const cleanExtension = String(extension || "").trim();
        const cleanNumber = String(number || "").trim();
        const cleanMobile = String(mobile || "").trim();

        if (!cleanName) {
            return res.status(400).json({
                error: "Name ist erforderlich."
            });
        }

        if (!cleanMobile) {
            if (!cleanExtension || !cleanNumber) {
                return res.status(400).json({
                    error: "Ohne Handynummer müssen Durchwahl und Nummer angegeben werden."
                });
            }
        }

        if (
            cleanExtension &&
            !/^\d{3}$/.test(cleanExtension)
        ) {
            return res.status(400).json({
                error: "Die Durchwahl muss genau 3 Ziffern haben."
            });
        }

        if (
            cleanNumber &&
            !/^\d{3}$/.test(cleanNumber)
        ) {
            return res.status(400).json({
                error: "Die Nummer muss genau 3 Ziffern haben."
            });
        }

        if (
            cleanMobile &&
            !/^\d{1,20}$/.test(cleanMobile)
        ) {
            return res.status(400).json({
                error: "Die Handynummer darf nur aus maximal 20 Ziffern bestehen."
            });
        }

        const result = await db.run(
            `
            INSERT INTO contacts
            (name, branch, extension, number, mobile)
            VALUES (?, ?, ?, ?, ?)
            `,
            cleanName,
            cleanBranch,
            cleanExtension,
            cleanNumber,
            cleanMobile
        );

        const contact = await db.get(
            `
            SELECT *
            FROM contacts
            WHERE id = ?
            `,
            result.lastID
        );

        res.status(201).json(contact);

    } catch (error) {
        console.error("KONTAKT ERSTELLEN FEHLER:", error);

        res.status(500).json({
            error: "Kontakt konnte nicht erstellt werden."
        });
    }
});


