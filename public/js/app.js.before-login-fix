        const data =
            await response.json();


        if (!response.ok) {

            throw new Error(
                data.error ||
                "Löschen fehlgeschlagen."
            );
        }


        await renderNotes(
            currentSection
        );

    } catch (error) {

        console.error(error);

        alert(error.message);

    }
}


