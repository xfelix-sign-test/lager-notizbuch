/* =========================================
   PASSWORT ÄNDERN
   ========================================= */

async function changePassword() {

    const currentPassword =
        document
            .getElementById("currentPassword")
            .value;


    const newPassword =
        document
            .getElementById("newPassword")
            .value;


    if (!currentPassword || !newPassword) {

        alert(
            "Bitte beide Passwörter eingeben."
        );

        return;
    }


    try {

        const response =
            await fetch(
                "/api/settings/password",
                {

                    method: "PUT",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            current_password:
                                currentPassword,

                            new_password:
                                newPassword

                        })

                }
            );


        const result =
            await response.json();


        if (!response.ok) {

            throw new Error(
                result.error ||
                "Passwort konnte nicht geändert werden."
            );
        }


        document
            .getElementById("currentPassword")
            .value = "";


        document
            .getElementById("newPassword")
            .value = "";


        alert(
            "Passwort wurde geändert."
        );

    } catch (error) {

        console.error(error);

        alert(error.message);

    }
}


