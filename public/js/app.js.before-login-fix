/* =========================================
   EINSTELLUNGEN SPEICHERN
   ========================================= */

async function saveSettings() {

    const data = {

        display_name:
            document
                .getElementById("displayName")
                .value
                .trim(),

        compact_mode:
            document
                .getElementById("compactMode")
                .checked,

        theme:
            document
                .getElementById("theme")
                .value

    };


    try {

        const response =
            await fetch(
                "/api/settings",
                {

                    method: "PUT",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify(data)

                }
            );


        if (!response.ok) {

            const result =
                await response.json();

            throw new Error(
                result.error ||
                "Einstellungen konnten nicht gespeichert werden."
            );
        }


        usernameDisplay.textContent =
            data.display_name ||
            usernameDisplay.textContent;


        document.body.dataset.theme =
            data.theme;


        alert(
            "Einstellungen gespeichert."
        );

    } catch (error) {

        console.error(error);

        alert(error.message);

